{
  "env": {
    "es2021": true,
    "node": true
  },
  "extends": ["airbnb", "prettier"],
  "plugins": ["prettier"],
  "rules": {
    "prettier/prettier": "warn",
    "no-unused-vars": "warn",
    "no-console": "off",
    "js": "always"
  },
  "parserOptions": {
    "ecmaVersion": 15,
    "sourceType": "module"
  }
}
