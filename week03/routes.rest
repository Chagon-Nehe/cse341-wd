@host = http://localhost:8081

### Events
GET {{host}}/api/events

### Get event by ID
GET {{host}}/api/events/6ab7e78da5179937f530e16f

### Create a new event
POST {{host}}/api/events
Content-Type: application/json

{
  "title": "Campus Tech Expo 2026",
  "description": "A showcase of student innovation, startups, and technology projects.",
  "category": "Technology",
  "date": "2026-10-15",
  "startTime": "09:00",
  "endTime": "16:00",
  "location": "Main Auditorium",
  "capacity": 300,
  "organizerId": "64d5d2f8c7a8b9a1d2b0e124",
  "status": "scheduled"
}

### Update an event
PUT {{host}}/api/events/64d5d2f8c7a8b9a1d2b0e123
Content-Type: application/json

{
  "title": "Campus Tech Expo 2026 Updated",
  "description": "Updated event details with keynote speakers and student demos.",
  "date": "2026-10-16",
  "status": "confirmed"
}

### Delete an event
DELETE {{host}}/api/events/64d5d2f8c7a8b9a1d2b0e123

### Event registrations
GET {{host}}/api/events/64d5d2f8c7a8b9a1d2b0e123/registrations

